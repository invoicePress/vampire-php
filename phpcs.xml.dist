<?xml version="1.0"?>
<ruleset name="einvoice-validator">
    <description>PSR-12 for src/ and devkit/.</description>
    <arg name="colors"/>
    <arg value="p"/>
    <file>src</file>
    <file>devkit</file>
    <rule ref="PSR12"/>

    <!-- devkit/Cli/*.php are CLI entry scripts, run directly (never autoloaded) - PSR-1's
         "declare symbols OR have side effects, not both" sniff is meant for autoloaded library
         files; every CLI entry point legitimately defines helpers and then calls them. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>devkit/Cli/*</exclude-pattern>
    </rule>
</ruleset>
